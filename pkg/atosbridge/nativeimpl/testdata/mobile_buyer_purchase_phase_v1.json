{
  "schema": "atos.native.mobile-buyer-purchase-phase.v1",
  "note": "Crash-safe purchase phase rules shared by the iOS and Android clients so a purchase resumed after process death never re-pays. Only Prepared may take the single funding lease; transitions are strictly forward; and at or after the funding lease, recovery is read-only and never refunds. Verified against the Go atosbridge phase functions.",
  "resume": [
    { "phase": "intent", "can_acquire_lease": false, "resume_action": "may_fund" },
    { "phase": "prepared", "can_acquire_lease": true, "resume_action": "may_fund" },
    { "phase": "funding_lease", "can_acquire_lease": false, "resume_action": "reconcile_never_refund" },
    { "phase": "funded", "can_acquire_lease": false, "resume_action": "reconcile_never_refund" },
    { "phase": "execution", "can_acquire_lease": false, "resume_action": "reconcile_never_refund" },
    { "phase": "receipt", "can_acquire_lease": false, "resume_action": "reconcile_never_refund" },
    { "phase": "release", "can_acquire_lease": false, "resume_action": "reconcile_never_refund" },
    { "phase": "resolved", "can_acquire_lease": false, "resume_action": "complete" },
    { "phase": "bogus", "can_acquire_lease": false, "resume_action": "invalid" }
  ],
  "transitions": [
    { "from": "intent", "to": "prepared", "can_advance": true },
    { "from": "prepared", "to": "funding_lease", "can_advance": true },
    { "from": "funding_lease", "to": "funded", "can_advance": true },
    { "from": "funded", "to": "execution", "can_advance": true },
    { "from": "release", "to": "resolved", "can_advance": true },
    { "from": "intent", "to": "resolved", "can_advance": true },
    { "from": "funded", "to": "funded", "can_advance": false },
    { "from": "funded", "to": "prepared", "can_advance": false },
    { "from": "resolved", "to": "release", "can_advance": false },
    { "from": "funding_lease", "to": "funding_lease", "can_advance": false },
    { "from": "bogus", "to": "funded", "can_advance": false },
    { "from": "funded", "to": "bogus", "can_advance": false }
  ]
}
